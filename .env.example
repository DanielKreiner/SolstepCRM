# =============================================================================
# Vorlage. Kopieren nach .env.local und ausfüllen.
# .env.local ist in .gitignore und darf niemals committet werden.
#
# Pflicht = die App startet ohne diese Werte nicht.
# Optional = die zugehörige Integration zeigt im UI "nicht verbunden",
#            die Jobs überspringen sich. Die App bleibt vollständig lauffähig.
# =============================================================================

# --- Branding (Pflicht) ------------------------------------------------------
# Der Produktname steht nirgends im Code. Rebranding = diese drei Zeilen.
NEXT_PUBLIC_PRODUCT_NAME="Betrieb"
NEXT_PUBLIC_LEGAL_ENTITY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_MAIL=""

# --- Supabase (Pflicht) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Nur für die CLI (Migrations, db push), nicht zur Laufzeit
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD=""

# --- Krypto (Pflicht) --------------------------------------------------------
# MAIL_CRED_KEY verschlüsselt die Postfach-Zugangsdaten der Mandanten
# (AES-256-GCM). Genau 32 Byte als 64 Hex-Zeichen.
# Erzeugen: openssl rand -hex 32
# ACHTUNG: Wird dieser Schlüssel getauscht, sind alle hinterlegten
# Postfach-Zugänge unbrauchbar und müssen neu eingegeben werden.
MAIL_CRED_KEY=""

# Signierte Links. Erzeugen: openssl rand -hex 32
PORTAL_TOKEN_SECRET=""
SHARE_TOKEN_SECRET=""
TRACK_TOKEN_SECRET=""

# Schützt /api/cron/*. Vercel sendet ihn als "Authorization: Bearer ..."
CRON_SECRET=""

# --- Systempostfach des Betreibers (Pflicht) ---------------------------------
# Einladungen, Passwort-Reset, Rechnungen an die Mandanten.
# Nicht das Postfach eines Mandanten und nicht solstep.de.
SYSTEM_MAIL_HOST=""
SYSTEM_MAIL_PORT="587"
SYSTEM_MAIL_USER=""
SYSTEM_MAIL_PASS=""
SYSTEM_MAIL_FROM=""

# --- Betreiber-Backoffice /ops (Pflicht) -------------------------------------
# Eigene Auth, getrennt von der Mandanten-Auth, MFA Pflicht.
OPS_ALLOWED_EMAILS=""

# --- Microsoft Entra (Pflicht für M365-Mandanten) ----------------------------
# App-Registrierung MULTI-TENANT (signInAudience: AzureADMultipleOrgs).
# Redirect-URI: {NEXT_PUBLIC_APP_URL}/api/oauth/microsoft/callback
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_REDIRECT_URI=""

# --- Step-Planer (optional) --------------------------------------------------
STEP_PLANER_WEBHOOK_SECRET=""

# --- Stripe (optional, ab Mandant 2) -----------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASE=""
STRIPE_PRICE_SEAT_FULL=""
STRIPE_PRICE_SEAT_FIELD=""

# --- Karte (optional) --------------------------------------------------------
MAPTILER_KEY=""

# --- Fehler (optional) -------------------------------------------------------
# Nur EU-Region verwenden.
SENTRY_DSN=""

# ---------------------------------------------------------------------
# Übergangsversand (Resend)
#
# CLAUDE.md 6.1 sieht Versand über das Postfach des Mandanten vor und
# schliesst Versanddienste aus; Abschnitt 0 verbietet solstep.de als
# Absenderdomain. Beides bleibt das Ziel.
#
# Diese drei Werte existieren nur, solange noch kein Postfach eingehängt
# ist — ohne sie bleibt jede Mail ungesendet in der Warteschlange liegen
# und niemand sieht je den Text. Mit der IMAP-Anbindung fallen sie weg,
# zusammen mit lib/mail/resend.ts.
# ---------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM=""
RESEND_FROM_NAME=""
