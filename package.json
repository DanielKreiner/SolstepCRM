{
  "name": "betrieb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:planer": "playwright test e2e/planer.spec.ts e2e/planer-zeichnen.spec.ts e2e/planer-foto.spec.ts e2e/planer-belegung.spec.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "seed:db": "supabase db push --include-seed",
    "seed:users": "tsx scripts/seed-demo.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed": "pnpm seed:db && pnpm seed:demo",
    "seed:vorfuehrung": "tsx scripts/seed-vorfuehrung.ts",
    "demo:aufbauen": "tsx scripts/demo-aufbauen.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.5.1",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-query": "5.101.4",
    "@types/nodemailer": "^8.0.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "imapflow": "^1.6.5",
    "next": "15.5.22",
    "nodemailer": "^9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "supabase",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "pdf-lib": "^1.17.1",
    "supabase": "2.110.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
